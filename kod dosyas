def create_features(df):
    g = df.groupby("machine_id")
    df["prod_lag1"] = g["production"].shift(1)
    df["prod_lag2"] = g["production"].shift(2)
    df["fault_lag1"] = g["faults"].shift(1)
    df["fault_lag2"] = g["faults"].shift(2)
    df["prod_roll5"] = g["production"].transform(lambda x: x.rolling(5, min_periods=1).mean())
    df["fault_roll5"] = g["faults"].transform(lambda x: x.rolling(5, min_periods=1).mean())
    df["prod_std5"] = g["production"].transform(lambda x: x.rolling(5, min_periods=1).std()).fillna(0)
    df["fault_std5"] = g["faults"].transform(lambda x: x.rolling(5, min_periods=1).std()).fillna(0)
    df["prod_trend"] = df["prod_lag1"] - df["prod_lag2"]
    df["fault_trend"] = df["fault_lag1"] - df["fault_lag2"]
    df["weekday"] = df["date"].dt.weekday 
    df["prod_roll7"] = g["production"].transform(lambda x: x.rolling(7, min_periods=1).mean())
    df["fault_roll7"] = g["faults"].transform(lambda x: x.rolling(7, min_periods=1).mean())
    df["fault_accel"] = df["fault_trend"] - g["faults"].shift(2).sub(g["faults"].shift(3)).fillna(0) 
    df["prod_fault_ratio"] = (df["production"] / (df["faults"] + 1)).round(2) 
    df = df.fillna(0)
    df["target_next_fault"] = g["faults"].shift(-1)
    df["fault_binary"] = (df["target_next_fault"] > (df["fault_roll5"] * 1.2)).astype(int)
    df["target_next_prod"] = g["production"].shift(-1)
    return df

