    EXCHANGE_PORT = 25 
    SENDER_EMAIL = "ai-system@yourcompany.com"
    
    msg = MIMEMultipart()
    msg['From'] = SENDER_EMAIL
    msg['To'] = ", ".join(recipient_email) if isinstance(recipient_email, list) else recipient_email
    msg['Subject'] = f"Yapay Zeka Günlük Raporu - {tahmin_tarihi}"
    
    html_body = f"""
