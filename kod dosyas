def dinamik_stratejik_tavsiye_uret(ariza_serisi, ariza_ham, hedef_tarih_dt, periyot="Haftalik"):
    if ariza_serisi.empty: return "- Kayda değer bir arıza örüntüsü tespit edilmemiştir."
        
    tavsiyeler = []
    bugun = pd.to_datetime(hedef_tarih_dt)
    gecmis_dosyasi = os.path.join(os.path.dirname(__file__), "tavsiye_gecmisi.json")
    try:
        with open(gecmis_dosyasi, "r", encoding="utf-8") as f: gecmis = json.load(f)
    except: gecmis = {}
        
    for ariza, sayi in ariza_serisi.items():
        ariza_up = str(ariza).upper()
        
        gecmis_1_hafta_bas = bugun - pd.Timedelta(days=14)
        gecmis_1_hafta_bit = bugun - pd.Timedelta(days=7)
        gecmis_h1_sayi = len(ariza_ham[(ariza_ham['aciklama'] == ariza) & (ariza_ham['date'] >= gecmis_1_hafta_bas.date()) & (ariza_ham['date'] < gecmis_1_hafta_bit.date())])
        
        vurgu_metni = ""
        periyot_anahtari = "Gunluk"
        if gecmis_h1_sayi >= 15:
            periyot_anahtari = "Haftalik"
            vurgu_metni = "(DİKKAT: Kronik Sorun!) "
            
        kat = "GENEL"
        if any(x in ariza_up for x in ["SENSÖR", "OKUMA"]): kat = "SENSÖR"
        elif any(x in ariza_up for x in ["VALF", "BASINÇ"]): kat = "VALF_PNÖMATİK"
        
        tespit_edilen_lokasyon = lokasyon_cikar(ariza_up)
        secenekler = COZUM_HAVUZU.get(kat, COZUM_HAVUZU["GENEL"]).get(periyot_anahtari, COZUM_HAVUZU["GENEL"]["Gunluk"])
        secilen_cozum = random.choice(secenekler) 
        
        nokta_atisi_cozum = secilen_cozum.format(lokasyon=tespit_edilen_lokasyon)
        aksiyon = f"{vurgu_metni}Raporlanan **'{ariza}'** arızası için: {nokta_atisi_cozum}"
        if periyot == "Aylik":
            aksiyon = aksiyon.replace("edilmelidir", "edilmesi için bütçe ayrılmalıdır")
        tavsiyeler.append(f"- {aksiyon}")
        
    with open(gecmis_dosyasi, "w", encoding="utf-8") as f:
        json.dump(gecmis, f, ensure_ascii=False, indent=4)
    return "\n".join(tavsiyeler)

