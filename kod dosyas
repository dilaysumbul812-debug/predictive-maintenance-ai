def get_machine_name(machine_id):
    """Verilen makine ID'sini ismine çevirir, bulamazsa ID'yi string olarak döndürür."""
    try:
        machine_id_int = int(machine_id)
        return MACHINE_NAME_MAP.get(machine_id_int, f"Makine {machine_id_int}")
    except (ValueError, TypeError):
        return str(machine_id)

