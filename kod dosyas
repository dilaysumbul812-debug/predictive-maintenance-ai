def load_and_merge(uretim_file, ariza_file):
    uretim = pd.read_excel(uretim_file)
    ariza = pd.read_excel(ariza_file)
    
    gecerli_makineler = [str(k) for k in MACHINE_NAME_MAP.keys()]
    uretim = uretim[uretim['Makinekimlik'].astype(str).str.replace('.0', '', regex=False).isin(gecerli_makineler)]
    ariza = ariza[ariza['Makinekimlik'].astype(str).str.replace('.0', '', regex=False).isin(gecerli_makineler)]
    
    uretim['Makinekimlik'] = uretim['Makinekimlik'].astype(str).str.replace('.0', '', regex=False).astype(int)
    ariza['Makinekimlik'] = ariza['Makinekimlik'].astype(str).str.replace('.0', '', regex=False).astype(int)
    
    uretim = uretim[['ID', 'Basladi_tarih', 'start_tarih', 'stop_tarih', 'uretimadet', 'Makinekimlik', 'uretim_sure_sn']]
    uretim.columns = ['id', 'basladi', 'start', 'stop', 'uretimadet', 'Makinekimlik', 'sure']
    ariza = ariza[['id', 'ariza_zaman', 'ariza_aciklama', 'Makinekimlik']]
    ariza.columns = ['id', 'ariza_zaman', 'aciklama', 'Makinekimlik']
    
    uretim['start'] = pd.to_datetime(uretim['start'])
    uretim['stop'] = pd.to_datetime(uretim['stop'])
    ariza['ariza_zaman'] = pd.to_datetime(ariza['ariza_zaman'])
    uretim['date'] = uretim['stop'].dt.date
    ariza['date'] = ariza['ariza_zaman'].dt.date

    import datetime
    sinir_saat = datetime.time(15, 5) 
    silinecek_u_indexler = []
    silinecek_a_indexler = []
    
    for gun in uretim['start'].dt.date.unique():
        gunluk_u = uretim[uretim['start'].dt.date == gun]
        mesai_sonrasi_u = gunluk_u[gunluk_u['start'].dt.time > sinir_saat]
        
        if not mesai_sonrasi_u.empty:
            aktif_makineler = mesai_sonrasi_u['Makinekimlik'].unique()
            if len(aktif_makineler) < 6:
                silinecek_u_indexler.extend(mesai_sonrasi_u.index.tolist())
                gunluk_a = ariza[ariza['ariza_zaman'].dt.date == gun]
                mesai_sonrasi_a = gunluk_a[(gunluk_a['ariza_zaman'].dt.time > sinir_saat) & (gunluk_a['Makinekimlik'].isin(aktif_makineler))]
                silinecek_a_indexler.extend(mesai_sonrasi_a.index.tolist())
                
    uretim = uretim.drop(silinecek_u_indexler)
    ariza = ariza.drop(silinecek_a_indexler)

    uretim = uretim.sort_values(['Makinekimlik', 'start'])
    uretim['onceki_stop'] = uretim.groupby(['date', 'Makinekimlik'])['stop'].shift(1)
    uretim['mudahale_suresi_sn'] = (uretim['start'] - uretim['onceki_stop']).dt.total_seconds()
    uretim['mudahale_suresi_sn'] = uretim['mudahale_suresi_sn'].apply(lambda x: x if 0 <= x <= 3600 else 0)
    
    prod = uretim.groupby(['date','Makinekimlik']).agg(
        production_max=('uretimadet', 'max'),
        production_min=('uretimadet', 'min'),
        toplam_bekleme_sn=('mudahale_suresi_sn', 'sum'),
        ortalama_cevrim_sn=('sure', 'mean')
    ).reset_index()
    prod['production'] = prod['production_max'] - prod['production_min'] + 1
    prod = prod.drop(columns=['production_max', 'production_min'])
    
    faults = ariza.groupby(['date','Makinekimlik']).agg(
